# Cấu hình AI & Camera cổng
DEFAULT_CAMERA_SOURCE=0
YOLO_MODEL_PATH=models/yolov8n_vinhgate_best.pt
ONNX_MODEL_PATH=models/yolov8n_vinhgate_best.onnx
USE_ONNX=False
OCR_ENGINE=paddleocr
MIN_CONFIDENCE_THRESHOLD=0.75
COOLDOWN_SECONDS=30
