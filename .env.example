# Cấu hình CSDL MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=vinhgate_db

# Cấu hình Máy chủ Backend
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
